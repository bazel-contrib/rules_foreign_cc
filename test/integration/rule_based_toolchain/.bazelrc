# Config for the INNER Bazel build (the one runner.sh spawns inside this
# scenario workspace). Import rfcc's consumer-facing flags by reference, as the
# other scenarios do, so this workspace stays in sync with them. rfcc is staged
# 3 levels up (matching the MODULE.bazel local_path_override) and ships
# .bazelrc.common via //:distribution.
import %workspace%/../../../.bazelrc.common

# Build for the platform that carries the `rule_based_cc` constraint so the
# cmake target resolves the rule-based toolchain while exec-configuration tools
# keep the autoconfigured host toolchain (see BUILD.bazel).
build --platforms=//:rule_based_host
