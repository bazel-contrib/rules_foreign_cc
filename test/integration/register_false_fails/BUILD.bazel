load("@rules_foreign_cc//foreign_cc:defs.bzl", "cmake")

cmake(
    name = "hello_cmake",
    lib_source = ":all_srcs",
    out_static_libs = ["libhello.a"],
)

filegroup(
    name = "all_srcs",
    srcs = glob(
        include = ["**"],
        exclude = [
            ".bazelignore",
            ".bazelrc",
            ".bazelversion",
            "BUILD",
            "BUILD.bazel",
            "MODULE.bazel",
            "MODULE.bazel.lock",
            "WORKSPACE",
            "WORKSPACE.bazel",
            "bazel-*/**",
        ],
    ),
)
