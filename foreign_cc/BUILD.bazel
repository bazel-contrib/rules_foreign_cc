    name = "distribution",
    srcs = glob(["**"]) + [
        "//foreign_cc/built_tools:distribution",
        "//foreign_cc/private:distribution",
        "//foreign_cc/settings:distribution",
    ],
    visibility = ["//:__subpackages__"],
)

