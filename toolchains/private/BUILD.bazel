load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("@rules_cc//cc:defs.bzl", "cc_binary")
load("//toolchains/native_tools:native_tools_toolchain.bzl", "native_tool_toolchain")

# The bzlmod hub (@rules_foreign_cc_toolchains, generated by
# foreign_cc/extensions.bzl) emits toolchain() targets that reference
# @rules_foreign_cc//toolchains/private:preinstalled_<tool> directly for
# system-mode tools. These must stay publicly visible: narrowing this package
# would surface as a cross-repo visibility error from a generated external-repo
# BUILD file, with no breadcrumb back to here.
package(default_visibility = ["//visibility:public"])

filegroup(
    name = "distribution",
    srcs = glob(["**"]),
    visibility = ["//:__subpackages__"],
)

native_tool_toolchain(
    name = "preinstalled_make",
    path = select({
        "@platforms//os:windows": "make.exe",
        "//conditions:default": "make",
    }),
)

native_tool_toolchain(
    name = "preinstalled_nmake",
    path = "nmake.exe",
)

native_tool_toolchain(
    name = "preinstalled_cmake",
    env = select({
        "@platforms//os:windows": {"CMAKE": "cmake.exe"},
        "//conditions:default": {"CMAKE": "cmake"},
    }),
    path = select({
        "@platforms//os:windows": "cmake.exe",
        "//conditions:default": "cmake",
    }),
)

cc_binary(
    # Note: this binary must be called ninja or meson (at least, maybe others)
    # refuse to use it, because meson has a cmake fallback for dependency
    # searches that only knows how to search the path
    # We use "out" as a dir because ninja_tool creates an output directory called
    # "ninja" which would otherwise conflict with our name.
    name = "out/ninja",
    srcs = [
        ":ninja_wrapper.cc",
    ],
    visibility = ["//visibility:public"],
)

alias(
    name = "ninja_wrapper",
    actual = ":out/ninja",
)

native_tool_toolchain(
    name = "preinstalled_ninja",
    env = {
        "NINJA": "$(execpath :ninja_wrapper)",
        "NINJA_FROM_PATH": "1",
    } | select({
        "@platforms//os:windows": {
            "REAL_NINJA": "ninja.exe",
        },
        "//conditions:default": {
            "REAL_NINJA": "ninja",
        },
    }),
    path = "$(execpath :ninja_wrapper)",
    target = ":ninja_wrapper",
)

# Registry-backed m4, make, meson, ninja and pkg-config. The other built tools
# carry their native_tool_toolchain in their spoke repo; these live here
# because rfcc cannot append targets to a registry module it doesn't own. One
# definition, not one per version, and both dependency models reach it.
#
# `target` is cfg = "exec", so `$(execpath)` resolves to m4.exe / make.exe /
# ninja.exe / pkg-config.exe on Windows without a select.
native_tool_toolchain(
    name = "built_m4",
    env = {"M4": "$(execpath @m4//:m4)"},
    path = "$(execpath @m4//:m4)",
    target = "@m4",
)

native_tool_toolchain(
    name = "built_make",
    env = {"MAKE": "$(execpath @make//:make)"},
    path = "$(execpath @make//:make)",
    target = "@make",
)

# A py_binary, not a cc_binary like its neighbours. `target` alone is enough:
# `$(execpath)` names the launcher and the framework stages the launcher's
# runfiles, which is where the `mesonbuild` package lives. No REAL_MESON here
# -- that variable belongs to rfcc's own meson_tool wrapper (see
# meson_tool_wrapper.py), which the registry module does not use.
native_tool_toolchain(
    name = "built_meson",
    env = {"MESON": "$(execpath @meson//:meson)"},
    path = "$(execpath @meson//:meson)",
    target = "@meson",
)

# ninja goes through the wrapper for the same reason preinstalled_ninja does
# (see ninja_wrapper.cc); that indirection is unrelated to how ninja is built.
native_tool_toolchain(
    name = "built_ninja",
    env = {
        "NINJA": "$(execpath :ninja_wrapper)",
        "REAL_NINJA": "$(execpath @ninja//:ninja)",
    },
    path = "$(execpath :ninja_wrapper)",
    target = ":ninja_wrapper",
    tools = ["@ninja"],
)

# `:pkg-config`, not `:pkgconf`: same binary, but the framework symlinks
# `path` into $EXT_BUILD_DEPS/bin under its own basename, and only the former
# is what configure scripts and CMake's FindPkgConfig look for.
native_tool_toolchain(
    name = "built_pkgconfig",
    env = {"PKG_CONFIG": "$(execpath @pkgconf//:pkg-config)"},
    path = "$(execpath @pkgconf//:pkg-config)",
    target = "@pkgconf//:pkg-config",
)

# Registered by the WORKSPACE path (toolchains/built_toolchains.bzl). bzlmod
# uses its own hub-generated equivalents instead, so a root module's
# registrations can be ordered ahead of rfcc's.
toolchain(
    name = "built_m4_toolchain",
    toolchain = ":built_m4",
    toolchain_type = "//toolchains:m4_toolchain",
)

toolchain(
    name = "built_make_toolchain",
    toolchain = ":built_make",
    toolchain_type = "//toolchains:make_toolchain",
)

toolchain(
    name = "built_meson_toolchain",
    toolchain = ":built_meson",
    toolchain_type = "//toolchains:meson_toolchain",
)

toolchain(
    name = "built_ninja_toolchain",
    toolchain = ":built_ninja",
    toolchain_type = "//toolchains:ninja_toolchain",
)

toolchain(
    name = "built_pkgconfig_toolchain",
    toolchain = ":built_pkgconfig",
    toolchain_type = "//toolchains:pkgconfig_toolchain",
)

native_tool_toolchain(
    name = "preinstalled_meson",
    path = select({
        "@platforms//os:windows": "meson.exe",
        "//conditions:default": "meson",
    }),
)

native_tool_toolchain(
    name = "preinstalled_autoconf",
    path = select({
        "@platforms//os:windows": "autoconf.exe",
        "//conditions:default": "autoconf",
    }),
)

native_tool_toolchain(
    name = "preinstalled_automake",
    path = select({
        "@platforms//os:windows": "automake.exe",
        "//conditions:default": "automake",
    }),
)

native_tool_toolchain(
    name = "preinstalled_m4",
    path = select({
        "@platforms//os:windows": "m4.exe",
        "//conditions:default": "m4",
    }),
)

native_tool_toolchain(
    name = "preinstalled_pkgconfig",
    path = select({
        "@platforms//os:windows": "pkg-config.exe",
        "//conditions:default": "pkg-config",
    }),
)

native_tool_toolchain(
    name = "preinstalled_msbuild",
    env = {
        "MSBUILD": "MSBuild.exe",
    },
    path = "MSBuild.exe",
    target_compatible_with = [
        "@platforms//os:windows",
    ],
)

bzl_library(
    name = "binary_spokes",
    srcs = ["binary_spokes.bzl"],
