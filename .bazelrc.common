build --enable_platform_specific_config

# Required by Meson on Windows
build:windows --action_env=PROCESSOR_ARCHITECTURE
build:windows --action_env=USERPROFILE

# Required when using the built meson toolchain on windows
build:windows --nobuild_python_zip

# Required by Meson and built pkg-config on Windows
build:windows --enable_runfiles

# These are required otherwise paths are too long
startup --windows_enable_symlinks
build:windows --action_env=MSYS=winsymlinks:nativestrict
test:windows --action_env=MSYS=winsymlinks:nativestrict
build:windows --@rules_foreign_cc//foreign_cc/settings:allow_building_in_tmp=True

# Apple toolchains come from toolchain resolution, never from the legacy
# --crosstool_top / --apple_crosstool_top path (which Bazel 9 removed). With
# this on, rules_apple's transitions set --platforms to apple_support's
# platforms and the apple_support cc toolchains (registered by its MODULE.bazel
# and by apple_support_dependencies() in WORKSPACE mode) resolve for them, so
# no platform_mappings file is needed. Bazel 9 behaves this way regardless;
# bazel 7 and 8 need the flag.
build:macos --incompatible_enable_apple_toolchain_resolution

common:ci --keep_going

# Provide CI shortcuts for these
common:spawn-standalone --spawn_strategy=standalone
common:spawn-default --show_progress

# There are three different bzlmod configurations!
common:bzlmod-yes --noenable_workspace --enable_bzlmod
common:bzlmod-no --enable_workspace --noenable_bzlmod
common:bzlmod-mixed --enable_workspace --enable_bzlmod

# Because we support both bzlmod and not right now, it's important that the
# actual dependencies we use stay in sync, and this means erroring when the
# root module doesn't get what it wants.
common:ci --check_direct_dependencies=error

# When the lockfile falls out of sync, it can crash bazel, so don't let it fall
# out of sync
common:ci --lockfile_mode=error

# When using foreign_rules_cc, we can get a much larger output which makes it
# hard to debug if it exceeds the limit. This increases the default 1MiB to 10MiB
common --experimental_ui_max_stdouterr_bytes=10485760

# Keep these config names around for BazelCI task selection. BazelCI expands
# dict values only when they stand alone, so we need the bazel-x.x names until
# https://github.com/bazelbuild/continuous-integration/pull/2526 lands
# everywhere.
#
# MODULE.bazel.lock is written by the primary Bazel (8.x) at lockFileVersion 24,
# which 7.x cannot read -- it hard-errors out of "Computing the main repository
# mapping" rather than falling back. One checked-in lockfile can't serve both
# versions, and the 8.x lanes are the ones that keep it honest, so opt the
# bazel 7 lanes out of the --lockfile_mode=error guard above rather than
# weakening it everywhere. `off` (not the `update` default) so a 7.x lane can't
# clobber the v24 lockfile either. BazelCI passes `--config=ci` before
# `${{ bazel_rc_config }}`, so this wins.
common:bazel-7.x --lockfile_mode=off
common:bazel-8.x --incompatible_disable_autoloads_in_main_repo

# Bazel 9 can't read the v24 lockfile either ("The version of MODULE.bazel.lock
# is not supported by this version of Bazel"), so it gets the same opt-out as
# bazel 7. It also needs no autoload flag: 9.x has no autoloads to disable.
common:bazel-9.x --lockfile_mode=off

# Bazel 9's built-in bazel_tools module depends on apple_support 2.5.2 and
# protobuf 33.4, above what examples/ and docs/ pin (1.24.5 and 29.3, the
# newest versions that still work in bazel 7 WORKSPACE mode), so the
# --check_direct_dependencies=error guard in common:ci would fail every 9.x
# lane before loading a single package. Downgrade it to a warning there; the
# 8.x lanes keep enforcing the pins.
common:bazel-9.x --check_direct_dependencies=warning

# Bazel 9 drops the native `py` fragments (--incompatible_remove_ctx_py_fragment),
# so rules_python no longer sees the --nobuild_python_zip in build:windows above
# and reads its own flag instead, which defaults to on for Windows. A zipped
# py_binary unpacks into a throwaway C:\temp\Bazel.runfiles_* tree, and meson
# records those paths as its regenerate command, so the first time ninja decides
# to regenerate build.ninja the interpreter is gone ("CreateProcess failed: The
# system cannot find the file specified"). This can't sit in build:windows next
# to the native flag: the test/integration scenarios import this file and don't
# depend on rules_python, and a label flag on an unknown repo is a hard error.
common:bazel-9.x --@rules_python//python/config_settings:build_python_zip=false
# Remind people to set good test timeouts / sizes
common --test_verbose_timeout_warnings

# Resource size tuning (default: fits 8-core machine)
common --@rules_foreign_cc//foreign_cc/settings:size_enormous_cpu=4
common --@rules_foreign_cc//foreign_cc/settings:size_large_cpu=3
