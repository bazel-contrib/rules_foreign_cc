load("@rules_foreign_cc//foreign_cc:defs.bzl", "cmake")

filegroup(
    name = "all_files",
    srcs = glob(["**"]),
)

cmake(
    name = "libjpeg_turbo",
    cache_entries = {
        "CMAKE_BUILD_TYPE": "Release",
        "WITH_JAVA": "0",
    },
    # rules_cc >= 0.2.22 passes MSVC `/std:c17`, which implies the conformant
    # preprocessor; `tjutil.h`'s `snprintf` macro ends `format, __VA_ARGS__`
    # and with no variadic args that leaves a trailing `,)` (C2059) instead of
    # swallowing the comma. libjpeg-turbo's CMake build sets no C standard, so
    # neither do we. No-op off MSVC.
    features = ["-default_c_std"],
    lib_source = ":all_files",
    out_shared_libs = select({
        "@platforms//os:linux": [
            "libjpeg.so",
            "libturbojpeg.so",
        ],
        "@platforms//os:macos": [
            "libjpeg.dylib",
            "libturbojpeg.dylib",
        ],
        "@platforms//os:windows": [
            "jpeg62.dll",
            "turbojpeg.dll",
        ],
    }),
    visibility = ["//visibility:public"],
)
