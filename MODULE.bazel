"""bazel-contrib/rules_foreign_cc"""

module(
    name = "rules_foreign_cc",
    version = "0.0.0",
)

bazel_dep(name = "bazel_features", version = "1.43.0")
bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_cc", version = "0.2.18")
bazel_dep(name = "rules_python", version = "1.9.0")
bazel_dep(name = "rules_shell", version = "0.6.1")
bazel_dep(name = "bazel_lib", version = "3.2.0")

# Dev dependencies
bazel_dep(name = "gazelle", version = "0.44.0", dev_dependency = True, repo_name = "bazel_gazelle")
bazel_dep(name = "bazel_skylib_gazelle_plugin", version = "1.9.0", dev_dependency = True)

# Note: 1.13 requires nodeps bzlmod deps, which requires bazel 7.6.0
bazel_dep(name = "aspect_rules_lint", version = "1.12.0", dev_dependency = True)
bazel_dep(name = "rules_bazel_integration_test", version = "0.37.1", dev_dependency = True)

bazel_binaries = use_extension(
    "@rules_bazel_integration_test//:extensions.bzl",
    "bazel_binaries",
    dev_dependency = True,
)
bazel_binaries.download(version_file = "//:.bazelversion")
use_repo(
    bazel_binaries,
    "bazel_binaries",
    "bazel_binaries_bazelisk",
    "build_bazel_bazel_.bazelversion",
)

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(python_version = "3.12")
use_repo(python, "python_3_12")

tools = use_extension("@rules_foreign_cc//foreign_cc:extensions.bzl", "tools")

# rfcc's own default toolchain registrations. These are the bzlmod-path
# mirror of the WORKSPACE default registrations (prebuilt + built + system in
# foreign_cc/repositories.bzl): one tag per tool rfcc enables by default, in
# the same default mode each path builds. A consuming root that declares its
# own tools.<tool>(...) tag, or tools.explicit(), suppresses the matching
# default below (root wins). The `tools` extension fails if this set diverges
# from toolchains.bzl's PREINSTALLED_TOOLS (see
# _assert_defaults_match_workspace in foreign_cc/extensions.bzl).
#
# nmake is deliberately absent: it shares the make_toolchain type and is
# selected only by an explicit `toolchain =` label, never registered for
# constraint resolution. Registering a default nmake toolchain would shadow
# make on Windows.
#
# Source-mode tools' per-version archives are still materialized whenever rfcc
# is in the graph (so macros like `meson_with_requirements` and rfcc's own
# //test:build_scripts can reach the hub-published `<tool>_built` /
# `<tool>_src_all` / `meson_src_*` aliases): the planner's all_required_spokes
# fetches each SOURCE_TOOLS archive at pick_source_version (the default version
# here), independent of these registration tags.
# cmake and ninja default to prebuilt binaries, which only exist for the five
# platforms in the binary spoke tables. The WORKSPACE defaults also
# registered a system (host-PATH) toolchain for each, giving any other host a
# fallback. The extra system tag below restores that: it emits an
# unconstrained hub entry (20_cmake_001_000 / 20_ninja_001_000) that lex-sorts
# AFTER the per-platform binary rows (20_cmake_000_*), so the binary toolchain
# still wins wherever a prebuilt exists and the system tool only resolves on
# hosts the binaries don't cover.
tools.cmake(
    mode = "binary",
    version = "3.31.12",
)
tools.cmake(mode = "system")
tools.ninja(
    mode = "binary",
    version = "1.13.2",
)
tools.ninja(mode = "system")
tools.make(
    mode = "source",
    version = "4.4.1",
)
tools.meson(
    mode = "source",
    version = "1.10.1",
)
tools.pkgconfig(
    mode = "source",
    version = "0.29.2",
)
tools.autoconf(mode = "system")
tools.automake(mode = "system")
tools.m4(mode = "system")
tools.msbuild(mode = "system")
use_repo(
    tools,
    "gettext_runtime",
    "glib_dev",
    "glib_src",
    "rules_foreign_cc_toolchains",
)

register_toolchains(
    "@rules_foreign_cc_toolchains//:all",
    "@python_3_12//:all",
)
